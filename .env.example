# Copy to .env and fill in. The .env file is git-ignored.

# Required for the GlassChat demo. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model and provider the chat uses. Left out or left empty, they fall back to the defaults shown here.
# The Guide button lets the model present the demos by itself; a strong model does that best,
# for example OPENROUTER_MODEL=anthropic/claude-opus-5.5
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# The only provider OpenRouter may route to. "any" lets OpenRouter choose.
OPENROUTER_PROVIDER=google-vertex/europe

# Messages each visitor may send per day (UTC).
CHAT_DAILY_LIMIT=8
# Ceiling for all visitors together per day. 0 turns it off.
CHAT_GLOBAL_DAILY_LIMIT=300
# Ceiling for guides (the Guide button) for all visitors together per day. 0 turns it off.
GUIDE_GLOBAL_DAILY_LIMIT=60

# Set to 1 only behind your own reverse proxy (Nginx): the visitor address is then read from X-Forwarded-For.
TRUST_PROXY=0

# Sent to OpenRouter as the referring site.
SITE_URL=https://lixelv.com
